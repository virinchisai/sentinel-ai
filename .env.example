# Generate secrets with: python scripts/configure.py
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Leave empty for keyword-only mode; nomic-embed-text enables local hybrid search.
EMBEDDING_MODEL=
DATABASE_URL=sqlite:///sentinel.db
ENVIRONMENT=development
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
GITHUB_DEFAULT_REPO=virinchisai/sentinel-ai
GITHUB_ALLOWED_REPOS=virinchisai/sentinel-ai
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# A separate, restricted read-only account, never the application database login.
TOOL_DATABASE_URL=
DOCUMENT_PARSER=basic
# Optional integrations
ENABLE_LANGFUSE=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=http://localhost:3000/login
